# Google Gemini API Key (Get free from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# CPAGrip Credentials (From Offer Tools -> API Feeds in cpagrip.com)
CPAGRIP_USER_ID=your_cpagrip_user_id
CPAGRIP_KEY=your_cpagrip_api_key

# Telegram Bot Alerts (Create bot via @BotFather, get ID via @userinfobot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Safe Bridge Landing Page URL (Your GitHub Pages or Cloudflare Pages URL)
BRIDGE_BASE_URL=https://rahul3427.github.io/rewards-hub/

# Settings
MIN_EPC=0.10
TARGET_GEO=US
